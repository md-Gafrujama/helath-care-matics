# Public site URL (set on Vercel Production to https://healthmatics.net)
NEXT_PUBLIC_SITE_URL=https://healthmatics.net

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Pexels — pexels.com/api (free)
PEXELS_API_KEY=your-pexels-api-key

# Shared secret for cron + admin bootstrap
# On Vercel, set the same value; Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-long-random-cron-secret

# Nodemailer SMTP (Gmail: App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="HealthMatics <you@gmail.com>"

# Admin bootstrap (npm run bootstrap — local once)
ADMIN_EMAIL=you@gmail.com
ADMIN_PASSWORD=your-secure-password
