# Public site URL (Vercel Production — must match primary domain / Search Console)
NEXT_PUBLIC_SITE_URL=https://www.healthmatics.net

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Pexels — pexels.com/api (free)
PEXELS_API_KEY=your-pexels-api-key

# Shared secret for cron + admin bootstrap
# On Vercel, set the same value; Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-long-random-cron-secret

# Nodemailer SMTP (Gmail: App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="HealthMatics <you@gmail.com>"

# First-party analytics + optional Google Analytics (Consent Mode)
# Set NEXT_PUBLIC_SITE_ANALYTICS=false to disable beacons entirely.
NEXT_PUBLIC_SITE_ANALYTICS=true
# NEXT_PUBLIC_SITE_ANALYTICS_URL=https://www.healthmatics.net/api/public/site-analytics/event
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin bootstrap (npm run bootstrap — local once; never commit real values)
ADMIN_EMAIL=you@gmail.com
ADMIN_PASSWORD=your-secure-password
